{
  "name": "kwader-whatsapp-node",
  "version": "2.11.21",
  "description": "KWADER Decentralized WhatsApp Cluster Engine",
  "main": "server.js",
  "bin": "./server.js",
  "pkg": {
    "scripts": [
      "dist/server.bundle.js"
    ],
    "assets": []
  },
  "scripts": {
    "start": "node server.js",
    "bundle": "npx esbuild server.js --bundle --platform=node --target=node18 --inject:./shim.js --outfile=dist/server.bundle.js",
    "build:exe": "npx esbuild server.js --bundle --platform=node --target=node18 --inject:./shim.js --outfile=dist/server.bundle.js && npx pkg dist/server.bundle.js --targets node18-win-x64 --output build/whatsapp-node.exe"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "socket.io": "^4.8.4"
  }
}