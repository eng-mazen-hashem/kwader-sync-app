{
  "name": "kwader-whatsapp-node",
  "version": "2.4.0",
  "description": "KWADER Decentralized WhatsApp Node - v2.4.0 Stability: Split-Brain Guard + Retry Logic + Parallel Processing",
  "main": "server.js",
  "bin": "./server.js",
  "pkg": {
    "scripts": [
      "server.js"
    ],
    "assets": []
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:exe": "pkg ./server.js --targets node18-win-x64 --output build/whatsapp-node.exe",
    "release": "node scripts/publish_release.js",
    "test-queue": "node test_queue.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@supabase/supabase-js": "^2.116.0",
    "adm-zip": "^0.5.10",
    "dotenv": "^16.4.5",
    "pg": "^8.23.0",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pkg": "^5.8.1",
    "supabase": "^2.117.0"
  },
  "author": "Kwader Team",
  "license": "ISC"
}
